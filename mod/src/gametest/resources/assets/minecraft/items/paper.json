{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      { "when": "head", "model": { "type": "minecraft:model", "model": "minecraft:item/paper" } }
    ],
    "fallback": {
      "type": "minecraft:range_dispatch",
      "property": "minecraft:custom_model_data",
      "fallback": { "type": "minecraft:model", "model": "minecraft:item/paper" },
      "entries": [
        { "threshold": 4100, "model": { "type": "minecraft:model", "model": "minecraft:item/wynn/weapon/archer/bow_basic_wood" } }
      ]
    }
  }
}
