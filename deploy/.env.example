# Copy to .env next to compose.yaml, then fill in. Never commit .env.

WT_ADMIN_USERNAME=admin
# Generate with: openssl rand -hex 32
WT_ADMIN_PASSWORD=

# Optional: the account allowed developer grants. See README.md.
WT_DEV_UUID=
# Optional: where the suspension message sends players.
WT_APPEAL_URL=

# Optional: where the database lives, and the user that owns it.
# WT_DATA_DIR=./data
# WT_UID=568
# WT_GID=568
